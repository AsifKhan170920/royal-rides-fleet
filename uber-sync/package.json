{
  "name": "royal-rides-uber-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Downloads the Uber Fleet Hub report and fetches the other platforms through their APIs into the Royal Rides Fleet Ledger",
  "scripts": {
    "sync": "node --env-file-if-exists=.env sync.js",
    "login": "node --env-file-if-exists=.env sync.js --login",
    "apis": "node --env-file-if-exists=.env sync.js --apis",
    "listen": "node --env-file-if-exists=.env sync.js --listen"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "papaparse": "^5.7.0",
    "playwright-core": "^1.63.0"
  }
}
