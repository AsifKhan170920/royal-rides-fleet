# Uber Sync settings – this file stays on this computer (it is not uploaded to GitHub)
# A Fair Tax portal user that has access to the Fleet Ledger (create it in the portal: Users & access)
PORTAL_USER=
PORTAL_PASSWORD=
# Where the daily Uber reports are kept
DOWNLOAD_DIR=D:\Client\Royal limousine\Uber trips
# How many past days each sync fetches (overlap is fine, duplicates are skipped)
SYNC_DAYS=2
# Uber Fleet Hub address
UBER_URL=https://supplier.uber.com/

# Platform APIs (Bolt, Yango, YAY, Welcome Pickups, Careem …) – switch each on and set its URLs on the Fleet Ledger page:
# Platforms & contracts -> platform -> API / data sync. Only the secrets go here, named after the platform id:
#   OAuth 2 client credentials:  BOLT_CLIENT_ID=   BOLT_CLIENT_SECRET=
#   API key in a header:         YANGO_API_KEY=
#   fixed bearer token:          YAY_TOKEN=
